# Copy to .env and change every "change-me" value. Never commit .env.

# --- Public entrypoint (Nginx) ---
HTTP_PORT=8080
# host:port the browser uses to reach Nginx; presigned MinIO URLs are signed for this host
PUBLIC_HOST=localhost:8080

# --- Postgres ---
POSTGRES_USER=pixelcloud
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=pixelcloud

# --- MinIO ---
MINIO_ROOT_USER=pixelcloud
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=pixelcloud

# --- API ---
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_TTL=1h
PRESIGN_TTL=10m
# uploaded images are deleted after this many days
RETENTION_DAYS=30
# per-user request limit enforced by the API (shared across nodes via Redis)
USER_RATE_LIMIT_PER_MIN=300

# --- Worker ---
JOB_TIMEOUT_SECONDS=60
JOB_MAX_ATTEMPTS=3
# a job whose worker stops heartbeating for this long is reclaimed by another worker
RECLAIM_IDLE_SECONDS=15
CLEANUP_INTERVAL_SECONDS=3600

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
GRAFANA_PORT=3000
